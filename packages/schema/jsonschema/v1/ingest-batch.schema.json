{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-ai.dev/schema/v1/ingest-batch.schema.json",
  "title": "SentinelIngestBatch",
  "description": "Batch envelope for POST /v1/ingest. At least one of runs, spans, or events must be non-empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/idString"
    },
    "batch_id": {
      "$ref": "common.schema.json#/$defs/idString",
      "description": "Optional client batch ID for deduplicating whole batches."
    },
    "sent_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "runs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "run.schema.json"
      }
    },
    "spans": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "span.schema.json"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "event.schema.json"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "runs": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": ["runs"]
    },
    {
      "properties": {
        "spans": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": ["spans"]
    },
    {
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1
        }
      },
      "required": ["events"]
    }
  ]
}
